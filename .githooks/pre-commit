#!/usr/bin/env bash
set -euo pipefail

repository_root=$(git rev-parse --show-toplevel 2>/dev/null) || {
	printf '✗ pre-commit: not inside a Git repository\n' >&2
	exit 1
}
cd "$repository_root"
hook_directory=$(cd "$(dirname "$0")" && pwd -P)
# shellcheck source=lib.sh
source "$hook_directory/lib.sh"
export PATH="$repository_root/.tools/bin:$PATH"

fail() {
	hook_fail "pre-commit: $1"
}

hook_step 'pre-commit: checking staged content'
git diff --cached --check || fail 'staged content has whitespace errors'

temporary_directory=$(mktemp -d "${TMPDIR:-/tmp}/wx-pre-commit.XXXXXX") || fail 'could not create temporary directory'
cleanup() {
	rm -rf "$temporary_directory"
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM

changed_paths="$temporary_directory/changed-paths"
format_paths="$temporary_directory/format-paths"
git diff --cached --name-only --no-renames -z --diff-filter=ACMRD >"$changed_paths" || fail 'could not list staged files'
git diff --cached --name-only --no-renames -z --diff-filter=ACMR >"$format_paths" || fail 'could not list staged Go files'

go_related=false
go_files=()
while IFS= read -r -d '' file; do
	case "$file" in
	*.go)
		go_related=true
		;;
	go.mod | go.sum)
		go_related=true
		;;
	esac
done <"$changed_paths"

if [[ "$go_related" != true ]]; then
	hook_success 'pre-commit: staged checks passed'
	exit 0
fi

command -v go >/dev/null 2>&1 || fail 'go is not installed or not in PATH'
command -v goimports >/dev/null 2>&1 || fail 'goimports is missing; run ./scripts/setup-hooks.sh'
command -v shadow >/dev/null 2>&1 || fail 'shadow is missing; run ./scripts/setup-hooks.sh'
command -v golangci-lint >/dev/null 2>&1 || fail 'golangci-lint is missing; run ./scripts/setup-hooks.sh'

while IFS= read -r -d '' file; do
	case "$file" in
	*.go)
		git diff --quiet -- "$file" || fail "$file has unstaged changes; run goimports and stage it manually"
		[[ -f "$file" ]] || fail "$file is missing from the worktree; restore or restage it"
		go_files+=("./$file")
		;;
	esac
done <"$format_paths"

if ((${#go_files[@]} > 0)); then
	hook_step "pre-commit: formatting ${#go_files[@]} staged Go file(s) with goimports"
	goimports -w "${go_files[@]}" || fail 'goimports failed'
	git add -- "${go_files[@]}"
fi

git diff --cached --check || fail 'formatted staged content has whitespace errors'
hook_step 'pre-commit: running go test ./...'
go test ./... || fail 'go test ./... failed'
hook_step 'pre-commit: running go vet ./...'
go vet ./... || fail 'go vet ./... failed'
hook_step 'pre-commit: running shadow analysis'
go vet -vettool="$(command -v shadow)" ./... || fail 'shadow analysis failed'
hook_step 'pre-commit: running golangci-lint'
golangci-lint run ./... || fail 'golangci-lint failed'
hook_success 'pre-commit: all checks passed'
